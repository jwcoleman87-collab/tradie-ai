# Server runtime variables. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=5000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_OUTPUT_TOKENS=5000
# Per call. At most three calls per message, across at most two allowed providers.
AI_REQUEST_TIMEOUT_MS=30000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes, base64 encoded. Back up and keep stable.
TOKEN_ENCRYPTION_KEY=
# Optional separate Google Ads OAuth app; blank reuses the Google client above.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
# Facebook Login for Business configuration with Page listing/read/publish scopes.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Pin a supported Graph API version from the selected Meta app dashboard.
META_GRAPH_VERSION=
# Keep false until account review and an explicit test-post approval.
FACEBOOK_PUBLISHING_ENABLED=false
